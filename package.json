{
	"name": "n8n-nodes-callsync",
	"version": "0.1.0",
	"description": "n8n nodes for CallSync: trigger workflows on new calls, recordings, AI call summaries and contact changes, and manage CallSync CRM contacts, tasks and notes.",
	"license": "MIT",
	"homepage": "https://callsyncapp.com",
	"keywords": [
		"n8n-community-node-package",
		"callsync",
		"call tracking",
		"call recording",
		"crm"
	],
	"author": {
		"name": "CallSync",
		"email": "manage@callsyncapp.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/call-sync/n8n-nodes-callsync.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CallSyncApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CallSync/CallSync.node.js",
			"dist/nodes/CallSync/CallSyncTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.4",
		"eslint": "9.32.0",
		"n8n-workflow": "2.16.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
